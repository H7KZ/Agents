{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-reporter=dot \"plugins/h7/test/**/*.test.ts\" \"scripts/test/**/*.test.ts\" \"bootstrap/test/**/*.test.ts\""
  },
  "mutate": [
    "plugins/h7/scripts/**/*.ts",
    "scripts/**/*.ts",
    "bootstrap/**/*.ts",
    "!**/test/**",
    "!**/*.test.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 80
  },
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
